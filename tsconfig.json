{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"declaration": true,
		"emitDeclarationOnly": true,
		"outDir": "./dist/types",
		"strict": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"skipLibCheck": false
	},
	"include": ["src/**/*"],
	"exclude": ["dist", "node_modules", "build", "vendor"]
}
